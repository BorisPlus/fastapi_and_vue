{
  "name": "project",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "format": "prettier --write --experimental-cli src/",
    "build": "vue-tsc && vite build",
    "download:api": "curl http://localhost:8100/openapi.json -o ./openapi.json",
    "generate:api": "orval --config orval.config.ts",
    "generate:api:watch": "orval --config orval.config.ts --watch",
    "dev:full": "npm run generate-api && npm run dev"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-query": "^1.26.0",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@orval/query": "^8.37.0",
    "@tanstack/vue-query": "^5.103.2",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "npm-run-all2": "^9.0.3",
    "orval": "^8.38.0",
    "prettier": "3.9.6",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
